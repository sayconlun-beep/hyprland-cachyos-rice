#!/usr/bin/env bash
# Open the wallhaven browser: a Quickshell panel (config/quickshell/rice/
# Wallhaven.qml) with search, filters and sorting over a thumbnail grid.
# It stays a script so Super+Ctrl+W, the settings hub and the keybind editor's
# label all keep pointing here. Filters live in ~/.config/rice/wallhaven.json.
exec qs -c rice ipc call wallhaven toggle
