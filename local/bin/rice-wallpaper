#!/usr/bin/env bash
# Wallpaper and theme in one step: awww shows the image, matugen derives the
# palette from it, rice-theme-reload pushes that into everything running.
#
#   rice-wallpaper set <file>       show <file> and re-theme
#   rice-wallpaper next | prev | random   within the active theme (Super+Alt+W)
#   rice-wallpaper restore          login: the last wallpaper, no transition
#   rice-wallpaper theme [file]     palette only - needs no daemon
#   rice-wallpaper current
#   rice-wallpaper mode [dark|light|toggle]   re-theme the current wallpaper
#                                   in that mode; no argument prints it
#
# Picking is done in the theme picker (ThemePicker.qml, Super+Shift+W), which
# goes through rice-theme. Named themes: while one is active, a file in its
# backgrounds/ gets the theme's exact colours (rice-theme-palette; matugen from
# its accent when dark/light is flipped away from the theme's own) and
# next/prev/random cycle those backgrounds. Showing any other file - one from
# ~/Pictures/Wallpapers, which is the "wallpaper" theme's list - goes back to
# the "wallpaper" theme, coloured from the image.
set -uo pipefail

DIR="${RICE_WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
CACHE="$HOME/.cache/rice"           # literal ~/.cache: matugen's config writes here too
CURRENT="$CACHE/wallpaper"          # symlink to the image on screen
# tonal-spot + --prefer saturation reproduces the palettes Noctalia derived.
# Without --prefer, matugen stops to ask when an image has several candidate
# source colours - and with no terminal attached it just fails.
SCHEME="${RICE_SCHEME:-scheme-tonal-spot}"

mkdir -p "$CACHE"

# dark or light, set by `rice-wallpaper mode` (the control centre's theme card)
MODE="$(cat "$CACHE/mode" 2>/dev/null)"
[[ "$MODE" == light ]] || MODE=dark

# the named theme in use (rice-theme); empty = colours come from the image
THEMES="${RICE_THEMES_DIR:-$HOME/.config/rice/themes}"
THEME_NAME="$(cat "$CACHE/theme" 2>/dev/null)"
THEME_DIR=""
[[ -n "$THEME_NAME" && -f "$THEMES/$THEME_NAME/colors.toml" ]] && THEME_DIR="$THEMES/$THEME_NAME"

die() { echo "rice-wallpaper: $*" >&2; notify-send -a rice-wallpaper "Wallpaper" "$*" 2>/dev/null; exit 1; }

list() {   # list [cycle]: with "cycle", the active theme's backgrounds instead
    local dir="$DIR"
    [[ "${1:-}" == cycle && -n "$THEME_DIR" ]] && dir="$THEME_DIR/backgrounds"
    find -L "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' \
        -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' \) | sort
}

current() { readlink -f "$CURRENT" 2>/dev/null; }

daemon() {
    awww query >/dev/null 2>&1 && return 0
    pgrep -x awww-daemon >/dev/null || setsid -f awww-daemon >/dev/null 2>&1
    for _ in $(seq 50); do
        awww query >/dev/null 2>&1 && return 0
        sleep 0.1
    done
    die "awww-daemon did not start"
}

toml_get() { grep -oP "^$1\\s*=\\s*\"\\K[^\"]+" "$2" 2>/dev/null | head -n1; }

in_theme() {   # is <file> one of the active theme's backgrounds?
    [[ -n "$THEME_DIR" ]] || return 1
    [[ "$(readlink -f -- "$1")" == "$(readlink -f -- "$THEME_DIR/backgrounds")"/* ]]
}

# Back to colours-from-the-wallpaper, with the dark/light it had before.
leave_theme() {
    [[ -n "$THEME_DIR" ]] || return 0
    rm -f "$CACHE/theme"
    if [[ -s "$CACHE/mode-wallpaper" ]]; then
        cp "$CACHE/mode-wallpaper" "$CACHE/mode"
        MODE="$(cat "$CACHE/mode")"
    fi
    THEME_NAME="" THEME_DIR=""
}

theme() {
    if in_theme "$1"; then
        local toml="$THEME_DIR/colors.toml" scheme accent own
        scheme="$(toml_get matugen_scheme "$toml")"
        accent="$(toml_get accent "$toml")"
        own="$(toml_get mode "$toml")"; [[ "$own" == light ]] || own=dark
        # fidelity keeps grey accents grey; tonal-spot turned Vantablack cyan
        if [[ "$MODE" == "$own" ]]; then
            # The theme's own colours, exactly: matugen's roles for the accent
            # fill any gap, rice-theme-palette overrides the rest, and
            # `matugen json` renders the templates from that verbatim.
            local fb="$CACHE/theme-fallback.json" js="$CACHE/theme-colors.json"
            matugen color hex "$accent" -m "$MODE" -t "${scheme:-scheme-fidelity}" --dry-run -j hex 2>/dev/null > "$fb" \
                && "$HOME/.local/bin/rice-theme-palette" json "$toml" "$fb" > "$js" \
                && matugen json "$js" -m "$MODE" -q \
                && "$HOME/.local/bin/rice-theme-palette" terminal "$toml" \
                || die "could not apply $THEME_NAME's colours"
        else
            # dark/light flipped away from the theme's own: matugen from the accent
            matugen color hex "$accent" -m "$MODE" -t "${scheme:-scheme-fidelity}" -q \
                || die "matugen could not make a palette from $THEME_NAME's accent"
        fi
    else
        matugen image "$1" -m "$MODE" -t "$SCHEME" --prefer saturation -q \
            || die "matugen could not derive a palette from $1"
    fi
}

show() {   # show <file> none|wipe
    local f
    f="$(readlink -f -- "$1")"
    [[ -f "$f" ]] || die "no such file: $1"
    daemon
    if [[ "$2" == none ]]; then
        awww img "$f" --resize crop --transition-type none
    else
        awww img "$f" --resize crop --transition-type wipe --transition-angle 30 \
            --transition-duration 1.1 --transition-fps 120 --transition-bezier .19,1,.22,1
    fi
    ln -sfn "$f" "$CURRENT"
    if in_theme "$f"; then
        mkdir -p "$CACHE/theme-bg"
        printf '%s\n' "$f" > "$CACHE/theme-bg/$THEME_NAME"
    else
        leave_theme
        printf '%s\n' "$f" > "$CACHE/wallpaper-last"
        # a new wallpaper (Wallhaven, a file dropped in) gets filed into its theme
        setsid -f "$HOME/.local/bin/rice-theme" sort --quiet >/dev/null 2>&1
    fi
    theme "$f"
    "$HOME/.local/bin/rice-theme-reload"
    greeter_sync
}

# The login screen follows too; a no-op unless auto-sync is on (see the script).
greeter_sync() { setsid -f "$HOME/.local/bin/rice-greeter-sync" --auto >/dev/null 2>&1; }

index_of_current() {   # prints -1 when the current image is not in the folder
    local cur i; cur="$(current)"
    for i in "${!all[@]}"; do
        [[ "$(readlink -f -- "${all[$i]}")" == "$cur" ]] && { echo "$i"; return; }
    done
    echo -1
}

load() {   # load [cycle]
    mapfile -t all < <(list "${1:-}")
    (( ${#all[@]} )) || die "no wallpapers in $DIR"
}

case "${1:-}" in
    set)
        [[ -n "${2:-}" ]] || die "usage: rice-wallpaper set <file>"
        show "$2" wipe
        ;;
    next|prev)
        load cycle
        idx="$(index_of_current)"; n=${#all[@]}
        if [[ "$1" == next ]]; then i=$(( (idx + 1) % n )); else
            (( idx < 0 )) && idx=0
            i=$(( (idx - 1 + n) % n ))
        fi
        show "${all[$i]}" wipe
        ;;
    random)
        load cycle
        idx="$(index_of_current)"; n=${#all[@]}
        i=$(( RANDOM % n ))
        (( n > 1 && i == idx )) && i=$(( (i + 1) % n ))
        show "${all[$i]}" wipe
        ;;
    restore)
        f="$(current)"
        [[ -f "$f" ]] || f="$(list | head -n1)"
        [[ -n "$f" ]] || exit 0
        show "$f" none
        ;;
    theme)
        f="${2:-$(current)}"
        [[ -f "$f" ]] || f="$(list | head -n1)"
        [[ -f "$f" ]] || die "no wallpaper to derive a palette from"
        [[ -e "$CURRENT" ]] || ln -sfn "$(readlink -f -- "$f")" "$CURRENT"
        theme "$f"
        ;;
    current)
        current
        ;;
    mode)
        want="${2:-}"
        case "$want" in
            "")         echo "$MODE"; exit 0 ;;
            toggle)     [[ "$MODE" == dark ]] && want=light || want=dark ;;
            dark|light) ;;
            *)          die "usage: rice-wallpaper mode [dark|light|toggle]" ;;
        esac
        printf '%s\n' "$want" > "$CACHE/mode"
        MODE="$want"
        f="$(current)"
        [[ -f "$f" ]] || f="$(list | head -n1)"
        [[ -f "$f" ]] || die "no wallpaper to derive a palette from"
        theme "$f"
        "$HOME/.local/bin/rice-theme-reload"
        greeter_sync
        ;;
    *)
        sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
        exit 2
        ;;
esac
